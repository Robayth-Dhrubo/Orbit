# ORBIT local API values (used by npm development commands)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/orbit
DEMO_PASSWORD=your-own-12-character-plus-demo-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
TEST_DATABASE_URL=postgresql://TEST_USER:PASSWORD@localhost:5432/orbit_test

# Docker Compose (root .env is local and never committed)
# Use URL-safe hexadecimal passwords, e.g. openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-hex-database-password
ORBIT_DB_PORT=5432
ORBIT_API_PORT=3000
